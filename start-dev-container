#!/usr/bin/env bash
# start-dev-container: Project-independent launcher for Neovim development container
# Loads user configs for fish, tmux, and nvim, with Clang toolchain, LSP, and debuggers.

set -e

# Early check for --verbose to enable bash tracing across entire execution
for arg in "$@"; do
    if [ "$arg" = "--verbose" ]; then
        set -x
        break
    fi
done

SCRIPT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"

# Load settings from settings.env if available
SETTINGS_FILE="${DEVCONTAINER_SETTINGS_FILE:-$SCRIPT_DIR/settings.env}"
if [ -f "$SETTINGS_FILE" ]; then
    # shellcheck source=/dev/null
    source "$SETTINGS_FILE"
fi

# Fallback defaults for VARIANTS if not configured in settings.env
if [ -z "${VARIANTS+x}" ] || [ ${#VARIANTS[@]} -eq 0 ]; then
    VARIANTS=(
        "clang|${BASE_IMAGE_CLANG:-${REGISTRY}/clang-22.1.8/main}|${IMAGE_TAG_CLANG:-devcontainer-nvim:clang}|clang|clang++"
        "clang-tsan|${BASE_IMAGE_CLANG_TSAN:-${REGISTRY}/clang-22.1.8-tsan/main}|${IMAGE_TAG_CLANG_TSAN:-devcontainer-nvim:clang-tsan}|clang|clang++"
        "gcc|${BASE_IMAGE_GCC:-${REGISTRY}/gcc-15.3.0/main}|${IMAGE_TAG_GCC:-devcontainer-nvim:gcc}|gcc|g++"
    )
fi

# Helper to parse a variant entry
# Sets: PARSED_VARIANT_NAME, PARSED_VARIANT_BASE, PARSED_VARIANT_TAG, PARSED_VARIANT_CC, PARSED_VARIANT_CXX
parse_variant_entry() {
    local entry="$1"
    local name="" base="" tag="" cc="" cxx=""

    if [[ "$entry" == *"|"* ]]; then
        IFS="|" read -r name base tag cc cxx <<< "$entry"
    elif [[ "$entry" == *:* ]]; then
        name="${entry%%:*}"
        base="${entry#*:}"
    else
        name="$entry"
    fi

    # Trim leading/trailing whitespace
    name="$(echo -n "$name" | xargs)"
    base="$(echo -n "$base" | xargs)"
    tag="$(echo -n "$tag" | xargs)"
    cc="$(echo -n "$cc" | xargs)"
    cxx="$(echo -n "$cxx" | xargs)"

    # Base image fallback (with global override support)
    if [ -n "$BASE_IMAGE" ]; then
        base="$BASE_IMAGE"
    elif [ -z "$base" ]; then
        base="${REGISTRY}/${name}/main"
    fi

    # Image tag fallback
    if [ -z "$tag" ]; then
        local safe_suffix
        safe_suffix="$(echo -n "$name" | tr -c 'a-zA-Z0-9_.-' '_')"
        tag="devcontainer-nvim:${safe_suffix}"
    fi

    # Compiler fallbacks
    if [ -z "$cc" ]; then
        case "$name" in
            *gcc*|*g++*) cc="gcc" ;;
            *)          cc="${DEFAULT_CC:-clang}" ;;
        esac
    fi
    if [ -z "$cxx" ]; then
        case "$name" in
            *gcc*|*g++*) cxx="g++" ;;
            *)          cxx="${DEFAULT_CXX:-clang++}" ;;
        esac
    fi

    PARSED_VARIANT_NAME="$name"
    PARSED_VARIANT_BASE="$base"
    PARSED_VARIANT_TAG="$tag"
    PARSED_VARIANT_CC="$cc"
    PARSED_VARIANT_CXX="$cxx"
}

find_variant() {
    local target="$1"
    for entry in "${VARIANTS[@]}"; do
        [ -z "$entry" ] && continue
        parse_variant_entry "$entry"
        if [ "$PARSED_VARIANT_NAME" = "$target" ]; then
            return 0
        fi
    done
    return 1
}

get_variant_names() {
    local names=()
    for entry in "${VARIANTS[@]}"; do
        [ -z "$entry" ] && continue
        parse_variant_entry "$entry"
        names+=("$PARSED_VARIANT_NAME")
    done
    echo "${names[*]}"
}

# --- Default Configuration ---
CONTAINER_VARIANT="${CONTAINER_VARIANT:-${DEFAULT_CONTAINER_VARIANT:-clang}}"
SHELL_MODE="${DEV_CONTAINER_SHELL:-${DEFAULT_SHELL_MODE:-tmux}}" # tmux, fish, or nvim
EXTRA_DOCKER_ARGS=()
REBUILD=false
NO_PULL=false
INIT_CONFIG=false
STOP_CONTAINER=false
VERBOSE=false

show_help() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [-- COMMAND...]

Starts the Neovim dev-container in the current working directory.
Loads your fish, tmux, and Neovim configurations from isolated Docker volumes.
Isolated volumes are used for Linux-specific configurations, .local data, and caches.

When no command is provided, the container runs in the background (-d) and
attaches via attach-dev-container, allowing sessions to exit and reconnect
without terminating the devcontainer.

Variants (configured in settings.env):
  -v, --variant VAR  Specify variant explicitly (default: ${DEFAULT_CONTAINER_VARIANT:-clang})
EOF
    for entry in "${VARIANTS[@]}"; do
        [ -z "$entry" ] && continue
        parse_variant_entry "$entry"
        printf "  --%-16s Use %s toolchain variant\n" "$PARSED_VARIANT_NAME" "$PARSED_VARIANT_NAME"
    done
    cat <<EOF

Modes:
  --tmux             Start inside a tmux session (default)
  --fish             Start directly into fish shell
  --nvim             Start directly into Neovim
  -c, --command CMD  Run custom command inside container

Options:
  --init-config      Copy host fish, tmux, and Neovim configs into the config volume
  --stop             Stop the running devcontainer for the current directory
  --re-build         Rebuild the container image before starting (pulls latest base image)
  --no-pull          Do not pull base image when rebuilding
  --verbose          Enable bash tracing (set -x)
  -e KEY=VAL         Pass additional environment variable
  --root             Run container directly as root (default: match host user)
  -w DIR             Set custom working directory inside container
  --name NAME        Set container name
  -h, --help         Show this help message

Examples:
  $(basename "$0")                    # Start tmux session in current directory
  $(basename "$0") --gcc              # Start with GCC toolchain
  $(basename "$0") --clang-tsan       # Start with TSan toolchain
  $(basename "$0") --nvim             # Open Neovim directly
  $(basename "$0") --fish             # Open Fish shell directly
  $(basename "$0") -- make -j8        # Run make inside dev-container
EOF
}

# --- Parse Arguments ---
COMMAND_OVERRIDE=()
AS_ROOT=false
CUSTOM_WORKDIR=""
CONTAINER_NAME=""

while [ $# -gt 0 ]; do
    case "$1" in
    -h | --help)
        show_help
        exit 0
        ;;
    -v | --variant)
        CONTAINER_VARIANT="$2"
        shift 2
        ;;
    --variant=*)
        CONTAINER_VARIANT="${1#*=}"
        shift
        ;;
    --tmux)
        SHELL_MODE="tmux"
        shift
        ;;
    --fish)
        SHELL_MODE="fish"
        shift
        ;;
    --nvim)
        SHELL_MODE="nvim"
        shift
        ;;
    -c | --command)
        COMMAND_OVERRIDE=("fish" "-c" "$2")
        shift 2
        ;;
    --init-config | --copy-config)
        INIT_CONFIG=true
        shift
        ;;
    --stop)
        STOP_CONTAINER=true
        shift
        ;;
    --root)
        AS_ROOT=true
        shift
        ;;
    --re-build | --rebuild)
        REBUILD=true
        shift
        ;;
    --no-pull)
        NO_PULL=true
        shift
        ;;
    --pull)
        NO_PULL=false
        shift
        ;;
    --verbose)
        VERBOSE=true
        set -x
        shift
        ;;
    -e)
        EXTRA_DOCKER_ARGS+=("-e" "$2")
        shift 2
        ;;
    -w)
        CUSTOM_WORKDIR="$2"
        shift 2
        ;;
    --name)
        CONTAINER_NAME="$2"
        shift 2
        ;;
    --)
        shift
        COMMAND_OVERRIDE=("$@")
        break
        ;;
    --*)
        opt_name="${1#--}"
        if find_variant "$opt_name"; then
            CONTAINER_VARIANT="$opt_name"
            shift
        else
            echo "Unknown option: $1" >&2
            show_help >&2
            exit 1
        fi
        ;;
    *)
        # If not an option, treat remainder as command
        COMMAND_OVERRIDE=("$@")
        break
        ;;
    esac
done

# --- Determine Variant & Image ---
if ! find_variant "$CONTAINER_VARIANT"; then
    echo "Unknown variant: $CONTAINER_VARIANT" >&2
    echo "Available variants: $(get_variant_names)" >&2
    exit 1
fi

IMAGE="$PARSED_VARIANT_TAG"
CONTAINER_CC="${PARSED_VARIANT_CC:-${DEFAULT_CC:-clang}}"
CONTAINER_CXX="${PARSED_VARIANT_CXX:-${DEFAULT_CXX:-clang++}}"

BUILD_SCRIPT="$SCRIPT_DIR/build-devcontainer.sh"

# Rebuild image if explicitly requested or if image does not exist locally
if [ "$REBUILD" = true ]; then
    echo "Rebuilding devcontainer image for variant '$CONTAINER_VARIANT'..."
    if [ -f "$BUILD_SCRIPT" ]; then
        BUILD_ARGS=("$CONTAINER_VARIANT")
        [ "$VERBOSE" = true ] && BUILD_ARGS+=("--verbose")
        [ "$NO_PULL" = true ] && BUILD_ARGS+=("--no-pull")
        "$BUILD_SCRIPT" "${BUILD_ARGS[@]}"
    else
        echo "Build script not found at '$BUILD_SCRIPT'. Cannot rebuild image." >&2
        exit 1
    fi
elif ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "Image '$IMAGE' not found locally."
    echo "Attempting to build it..."
    if [ -f "$BUILD_SCRIPT" ]; then
        BUILD_ARGS=("$CONTAINER_VARIANT")
        [ "$VERBOSE" = true ] && BUILD_ARGS+=("--verbose")
        [ "$NO_PULL" = true ] && BUILD_ARGS+=("--no-pull")
        "$BUILD_SCRIPT" "${BUILD_ARGS[@]}"
    else
        echo "Build script not found at '$BUILD_SCRIPT'. Please build the image first." >&2
        exit 1
    fi
fi

# --- Host User & Paths ---
HOST_USER="$(id -un)"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"
HOST_HOME="$HOME"
CURRENT_DIR="$(pwd)"
WORKDIR="${CUSTOM_WORKDIR:-$CURRENT_DIR}"

# Handle --stop request
if [ "$STOP_CONTAINER" = true ]; then
    TARGET_CID=""
    if [ -n "$CONTAINER_NAME" ]; then
        if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" = "true" ]; then
            TARGET_CID="$CONTAINER_NAME"
        fi
    else
        for cid in $(docker ps --filter "status=running" --format '{{.ID}}'); do
            IFS=$'\t' read -r cdir clabel <<< "$(docker inspect --format $'{{.Config.WorkingDir}}\t{{index .Config.Labels "devcontainer"}}' "$cid" 2>/dev/null || true)"
            if [ "$clabel" = "true" ] && [ "$cdir" = "$WORKDIR" ]; then
                TARGET_CID="$cid"
                break
            fi
        done
    fi

    if [ -n "$TARGET_CID" ]; then
        echo "Stopping devcontainer ($TARGET_CID) for '$WORKDIR'..."
        docker stop "$TARGET_CID"
        exit 0
    else
        echo "No running devcontainer found for '$WORKDIR'." >&2
        exit 1
    fi
fi

# Determine Git project root if applicable
GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"

# --- Storage Volumes & Mounts Configuration ---
STORAGE_SPECS=()
add_volume_spec() {
    local src="$1"
    local dst="$2"
    local opts="$3"

    [ -z "$src" ] && return 0
    case "$src" in
        none|off|false) return 0 ;;
    esac

    # Expand ~ and $HOME
    src="${src/#\~/$HOST_HOME}"
    src="${src/\$HOME/$HOST_HOME}"
    dst="${dst/#\~/$HOST_HOME}"
    dst="${dst/\$HOME/$HOST_HOME}"

    # Resolve relative paths for host bind mounts (Docker requires absolute paths for -v)
    if [[ "$src" == ./* ]] || [[ "$src" == ../* ]]; then
        src="$(cd "$src" 2>/dev/null && pwd || echo "$PWD/${src#./}")"
    fi

    STORAGE_SPECS+=("${src}|${dst}|${opts}")
}

for entry in "${VOLUMES[@]}"; do
    [ -z "$entry" ] && continue
    if [[ "$entry" == *:* ]]; then
        IFS=":" read -r e_src e_dst e_opts <<< "$entry"
        add_volume_spec "$e_src" "$e_dst" "$e_opts"
    else
        add_volume_spec "$entry" "${HOST_HOME}/.${entry#devcontainer_}" ""
    fi
done

# Resolve volume mounted to ~/.config for --init-config
VOLUME_CONFIG=""
for spec in "${STORAGE_SPECS[@]}"; do
    IFS="|" read -r s_src s_dst _ <<< "$spec"
    if [ "$s_dst" = "${HOST_HOME}/.config" ]; then
        VOLUME_CONFIG="$s_src"
        break
    fi
done

# Ensure volumes exist, initialize ownership for new named volumes, and build mount flags
STORAGE_MOUNTS=()
DEV_CHOWN_DIRS=()
SEEN_TARGETS=" "

for spec in "${STORAGE_SPECS[@]}"; do
    IFS="|" read -r src dst opts <<< "$spec"
    [ -z "$dst" ] && continue

    # Prevent duplicate mounts to the same destination
    if [[ "$SEEN_TARGETS" == *" $dst "* ]]; then
        continue
    fi
    SEEN_TARGETS+="$dst "

    # Check if src is a Docker named volume (does not start with / or .)
    if [[ "$src" != /* ]] && [[ "$src" != .* ]]; then
        if ! docker volume inspect "$src" >/dev/null 2>&1; then
            docker volume create "$src" >/dev/null
            docker run --rm -v "${src}:/vol" "$IMAGE" chown -R "${HOST_UID}:${HOST_GID}" /vol 2>/dev/null || true
        fi
    else
        [ ! -e "$src" ] && mkdir -p "$src" 2>/dev/null || true
    fi

    mount_str="${src}:${dst}"
    [ -n "$opts" ] && mount_str="${mount_str}:${opts}"
    STORAGE_MOUNTS+=("-v" "$mount_str")

    if [[ "$dst" == "${HOST_HOME}"/* ]]; then
        DEV_CHOWN_DIRS+=("$dst")
    fi
done

# Configuration initialization: guarded behind --init-config
if [ "$INIT_CONFIG" = true ]; then
    echo "Initializing '${VOLUME_CONFIG}' volume with host configurations..."
    CONFIG_MOUNTS=()
    [ -d "$HOST_HOME/.config/fish" ] && CONFIG_MOUNTS+=("-v" "$HOST_HOME/.config/fish:/src/fish:ro")
    [ -d "$HOST_HOME/.config/tmux" ] && CONFIG_MOUNTS+=("-v" "$HOST_HOME/.config/tmux:/src/tmux:ro")
    [ -d "$HOST_HOME/.config/nvim" ] && CONFIG_MOUNTS+=("-v" "$HOST_HOME/.config/nvim:/src/nvim:ro")
    if [ ${#CONFIG_MOUNTS[@]} -gt 0 ]; then
        docker run --rm \
            -v "${VOLUME_CONFIG}:/dest" \
            "${CONFIG_MOUNTS[@]}" \
            "$IMAGE" \
            bash -c '
                [ -d /src/fish ] && mkdir -p /dest/fish && cp -a /src/fish/. /dest/fish/
                [ -d /src/tmux ] && mkdir -p /dest/tmux && cp -a /src/tmux/. /dest/tmux/
                [ -d /src/nvim ] && mkdir -p /dest/nvim && cp -a /src/nvim/. /dest/nvim/
                chown -R '"$HOST_UID:$HOST_GID"' /dest 2>/dev/null || true
            '
        echo "Configurations copied successfully into '${VOLUME_CONFIG}'."
    else
        echo "Warning: No host configuration directories found in '$HOST_HOME/.config'." >&2
    fi
else
    # Check if config folders in VOLUME_CONFIG are empty or missing
    if ! docker run --rm -v "${VOLUME_CONFIG}:/dest:ro" "$IMAGE" bash -c '
        for cfg in fish tmux nvim; do
            if [ ! -d "/dest/$cfg" ] || [ -z "$(ls -A "/dest/$cfg" 2>/dev/null)" ]; then
                exit 1
            fi
        done
    ' 2>/dev/null; then
        echo "Warning: Configuration folders (fish, tmux, nvim) in '${VOLUME_CONFIG}' are empty or missing." >&2
        echo "Pass --init-config to copy them from your host (~/.config/)." >&2
    fi
fi

# Symbolizer, sanitizer & runtime settings from settings.env (or defaults)
SYMBOLIZER_PATH="${SYMBOLIZER_PATH:-/usr/local/bin/llvm-symbolizer}"
DEV_TIMEZONE="${DEV_TIMEZONE:-Europe/Berlin}"
ASAN_OPTIONS="${ASAN_OPTIONS:-detect_container_overflow=0:detect_leaks=1:symbolize=1}"
TSAN_OPTIONS="${TSAN_OPTIONS:-external_symbolizer_path=${SYMBOLIZER_PATH}:symbolize=1:halt_on_error=1:second_deadlock_stack=1:ignore_noninstrumented_modules=1:die_after_fork=0}"

# --- Assemble Docker Arguments ---
DOCKER_RUN_ARGS=(
    "--rm"
    "--init"
    "--label" "devcontainer=true"
    "-w" "$WORKDIR"
)

# Apply base docker run arguments from settings.env (or default flags)
if [ -n "${DOCKER_RUN_BASE_ARGS+x}" ] && [ ${#DOCKER_RUN_BASE_ARGS[@]} -gt 0 ]; then
    DOCKER_RUN_ARGS+=("${DOCKER_RUN_BASE_ARGS[@]}")
else
    DOCKER_RUN_ARGS+=(
        "--privileged"
        "--cap-add=SYS_PTRACE"
        "--cap-add=PERFMON"
        "--security-opt" "seccomp=unconfined"
        "--net=host"
    )
fi

# Apply extra docker run arguments configured in settings.env
if [ -n "${DOCKER_RUN_EXTRA_ARGS+x}" ] && [ ${#DOCKER_RUN_EXTRA_ARGS[@]} -gt 0 ]; then
    DOCKER_RUN_ARGS+=("${DOCKER_RUN_EXTRA_ARGS[@]}")
fi

# Container name
if [ -n "$CONTAINER_NAME" ]; then
    DOCKER_RUN_ARGS+=("--name" "$CONTAINER_NAME")
fi

# Storage volumes and host mounts configured via settings.env
if [ ${#STORAGE_MOUNTS[@]} -gt 0 ]; then
    DOCKER_RUN_ARGS+=("${STORAGE_MOUNTS[@]}")
fi

# Always mount projects directory if configured
PROJECTS_DIR="${PROJECTS_DIR:-$HOST_HOME/projects}"
if [ -n "$PROJECTS_DIR" ]; then
    mkdir -p "$PROJECTS_DIR"
    DOCKER_RUN_ARGS+=(
        "-v" "$PROJECTS_DIR:$PROJECTS_DIR"
    )
fi

# Mount current project working directory
DOCKER_RUN_ARGS+=(
    "-v" "$WORKDIR:$WORKDIR"
    "-v" "/etc/hosts:/etc/hosts:ro"
)

# Mount Git project root if different from workdir
if [ -n "$GIT_ROOT" ] && [ "$GIT_ROOT" != "$WORKDIR" ] && [ -d "$GIT_ROOT" ]; then
    DOCKER_RUN_ARGS+=("-v" "$GIT_ROOT:$GIT_ROOT")
fi

# Mount TMPDIR if defined
if [ -n "$TMPDIR" ] && [ -d "$TMPDIR" ]; then
    DOCKER_RUN_ARGS+=("-v" "$TMPDIR:$TMPDIR")
fi

# Mount host git configuration and SSH if available
if [ -f "$HOST_HOME/.gitconfig" ]; then
    DOCKER_RUN_ARGS+=("-v" "$HOST_HOME/.gitconfig:$HOST_HOME/.gitconfig:ro")
fi
if [ -d "$HOST_HOME/.ssh" ]; then
    DOCKER_RUN_ARGS+=("-v" "$HOST_HOME/.ssh:$HOST_HOME/.ssh:ro")
fi
if [ -n "$SSH_AUTH_SOCK" ] && [ -e "$SSH_AUTH_SOCK" ]; then
    if [ "$(uname -s)" = "Darwin" ]; then
        # On macOS (Docker Desktop / OrbStack), mount the VM bridge socket
        DOCKER_RUN_ARGS+=(
            "-v" "/run/host-services/ssh-auth.sock:/run/host-services/ssh-auth.sock"
            "-e" "SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock"
        )
    else
        DOCKER_RUN_ARGS+=("-v" "$SSH_AUTH_SOCK:$SSH_AUTH_SOCK" "-e" "SSH_AUTH_SOCK=$SSH_AUTH_SOCK")
    fi
fi

# Ccache configuration if available
if [ -d "$HOST_HOME/.ccache" ]; then
    DOCKER_RUN_ARGS+=(
        "-e" "CCACHE_DIR=${HOST_HOME}/.ccache"
        "-e" "CCACHE_CONFIGPATH=${HOST_HOME}/.ccache/ccache.conf"
    )
    if [ -n "$GIT_ROOT" ]; then
        DOCKER_RUN_ARGS+=("-e" "CCACHE_BASEDIR=${GIT_ROOT}/..")
    fi
fi

# Base Environment Variables
DOCKER_RUN_ARGS+=(
    "-e" "DEV_USER=${HOST_USER}"
    "-e" "DEV_UID=${HOST_UID}"
    "-e" "DEV_GID=${HOST_GID}"
    "-e" "DEV_HOME=${HOST_HOME}"
    "-e" "PATH=${HOST_HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    "-e" "EDITOR=${EDITOR:-nvim}"
    "-e" "VISUAL=${VISUAL:-nvim}"
    "-e" "LANG=C.UTF-8"
    "-e" "LC_ALL=C.UTF-8"
    "-e" "TERM=${TERM:-xterm-256color}"
    "-e" "COLORTERM=${COLORTERM:-truecolor}"
    "-e" "CC=${CONTAINER_CC}"
    "-e" "CXX=${CONTAINER_CXX}"
    "-e" "ASAN_SYMBOLIZER_PATH=${SYMBOLIZER_PATH}"
    "-e" "LLVM_SYMBOLIZER_PATH=${SYMBOLIZER_PATH}"
    "-e" "ASAN_OPTIONS=${ASAN_OPTIONS}"
    "-e" "TSAN_OPTIONS=${TSAN_OPTIONS}"
    "-e" "TZ=${DEV_TIMEZONE}"
    "-e" "DEV_CHOWN_DIRS=${DEV_CHOWN_DIRS[*]}"
)

# If in a git repository with tsan.supp, pass suppressions
if [ -n "$GIT_ROOT" ] && [ -f "$GIT_ROOT/tsan.supp" ]; then
    DOCKER_RUN_ARGS+=("-e" "TSAN_OPTIONS=external_symbolizer_path=${SYMBOLIZER_PATH}:symbolize=1:halt_on_error=1:second_deadlock_stack=1:ignore_noninstrumented_modules=1:die_after_fork=0:suppressions=${GIT_ROOT}/tsan.supp")
fi

if [ "$AS_ROOT" = true ]; then
    DOCKER_RUN_ARGS+=("-e" "DEV_USER=root")
fi

# Append any extra user-specified docker arguments
if [ ${#EXTRA_DOCKER_ARGS[@]} -gt 0 ]; then
    DOCKER_RUN_ARGS+=("${EXTRA_DOCKER_ARGS[@]}")
fi

# Handle execution: foreground command vs. detached container + attach
if [ ${#COMMAND_OVERRIDE[@]} -gt 0 ]; then
    # Command explicitly provided: run directly in foreground
    if [ -t 0 ] && [ -t 1 ]; then
        DOCKER_RUN_ARGS+=("-it")
    else
        DOCKER_RUN_ARGS+=("-i")
    fi
    exec docker run "${DOCKER_RUN_ARGS[@]}" "$IMAGE" "${COMMAND_OVERRIDE[@]}"
fi

# No command explicitly provided:
# Start container with -d (if not already running) and attach using attach-dev-container
CONTAINER_CMD=()
case "$SHELL_MODE" in
nvim)
    CONTAINER_CMD=("nvim")
    ;;
fish)
    CONTAINER_CMD=("fish")
    ;;
tmux)
    # Session name derived from current directory
    SESSION_NAME="$(basename "$WORKDIR" | tr '.' '_')"
    CONTAINER_CMD=("tmux" "new-session" "-A" "-s" "$SESSION_NAME" "fish")
    ;;
esac

TARGET_CID=""

if [ -n "$CONTAINER_NAME" ]; then
    if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" = "true" ]; then
        TARGET_CID="$CONTAINER_NAME"
    fi
else
    # Find running devcontainer with same working directory and matching image
    for cid in $(docker ps --filter "status=running" --format '{{.ID}}'); do
        IFS=$'\t' read -r cdir clabel cimage <<< "$(docker inspect --format $'{{.Config.WorkingDir}}\t{{index .Config.Labels "devcontainer"}}\t{{.Config.Image}}' "$cid" 2>/dev/null || true)"
        if [ "$clabel" = "true" ] && [ "$cdir" = "$WORKDIR" ] && [ "$cimage" = "$IMAGE" ]; then
            TARGET_CID="$cid"
            break
        fi
    done
fi

if [ -n "$TARGET_CID" ] && [ "$REBUILD" = true ]; then
    echo "Rebuild requested. Stopping existing container ($TARGET_CID)..."
    docker stop "$TARGET_CID" >/dev/null 2>&1 || true
    TARGET_CID=""
fi

if [ -z "$TARGET_CID" ]; then
    echo "Starting devcontainer in background..."
    if ! TARGET_CID=$(docker run -d "${DOCKER_RUN_ARGS[@]}" "$IMAGE" sleep infinity); then
        echo "Error: Failed to start devcontainer." >&2
        exit 1
    fi
fi

# Find attach script
ATTACH_SCRIPT="$SCRIPT_DIR/attach-dev-container"
if [ ! -x "$ATTACH_SCRIPT" ]; then
    ATTACH_SCRIPT="attach-dev-container"
fi

ATTACH_ARGS=()
[ "$AS_ROOT" = true ] && ATTACH_ARGS+=("--root")
[ -n "$CUSTOM_WORKDIR" ] && ATTACH_ARGS+=("-w" "$CUSTOM_WORKDIR")
ATTACH_ARGS+=("$TARGET_CID" "--" "${CONTAINER_CMD[@]}")

exec "$ATTACH_SCRIPT" "${ATTACH_ARGS[@]}"
