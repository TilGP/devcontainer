# ==============================================================================
# Devcontainer Settings Configuration Template (settings.env.dist)
# ==============================================================================
# Copy this file to settings.env and customize for your environment:
#   cp settings.env.dist settings.env
#
# This file centralizes configuration for building and running the devcontainer.
# Edit this file to customize base images, image tags, docker run arguments,
# volume names, and runtime environment without modifying the shell scripts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Docker Image & Registry Configuration (for building devcontainer images)
# ------------------------------------------------------------------------------
# Host architecture for toolchain (auto-detected if commented out or empty)
TOOLCHAIN_ARCH="$(uname -m)"
case "${TOOLCHAIN_ARCH}" in
    aarch64|arm64) TOOLCHAIN_ARCH="aarch64" ;;
    x86_64|amd64)  TOOLCHAIN_ARCH="x86_64" ;;
esac

# Toolchain registry base URL
REGISTRY="registry.example.com/toolchain/trixie/${TOOLCHAIN_ARCH}"

# Base toolchain images for each variant
BASE_IMAGE_CLANG="${REGISTRY}/clang-22.1.8/main"
BASE_IMAGE_CLANG_TSAN="${REGISTRY}/clang-22.1.8-tsan/main"
BASE_IMAGE_CLANGPP="${REGISTRY}/clang-22.1.8/main"

# Optional: Global base image override.
# If non-empty, this image will be used as the BASE_IMAGE for all variants.
# BASE_IMAGE="registry.example.com/toolchain/trixie/${TOOLCHAIN_ARCH}/clang-22.1.8/main"
BASE_IMAGE=""

# ------------------------------------------------------------------------------
# 2. Devcontainer Images & Tags (for building and running)
# ------------------------------------------------------------------------------
# Devcontainer target image names and tags for each variant
IMAGE_TAG_CLANG="devcontainer-nvim:clang"
IMAGE_TAG_CLANG_TSAN="devcontainer-nvim:clang-tsan"
IMAGE_TAG_CLANGPP="devcontainer-nvim:clangpp"

# Default variant to use when no CLI flag (--clang, --clang-tsan, --clang++) is given
# Options: clang, clang-tsan, clang++
DEFAULT_CONTAINER_VARIANT="clang"

# Default shell mode when launching the devcontainer without an explicit command
# Options: tmux, fish, nvim
DEFAULT_SHELL_MODE="tmux"

# ------------------------------------------------------------------------------
# 3. Docker Run Arguments
# ------------------------------------------------------------------------------
# Base Docker run flags used when launching the container
DOCKER_RUN_BASE_ARGS=(
    "--privileged"
    "--cap-add=SYS_PTRACE"
    "--cap-add=PERFMON"
    "--security-opt" "seccomp=unconfined"
    "--net=host"
)

# Additional docker run flags (e.g. port forwards, GPU flags, DNS, extra mounts)
# Add your custom arguments here without editing start-dev-container.
DOCKER_RUN_EXTRA_ARGS=(
    # Examples:
    # "-p" "8080:8080"
    # "--dns" "8.8.8.8"
)

# ------------------------------------------------------------------------------
# 4. Storage Volumes & Host Mounts
# ------------------------------------------------------------------------------
# Named Docker volumes for Linux-isolated environment directories
VOLUME_LOCAL="devcontainer_local"
VOLUME_CONFIG="devcontainer_config"
VOLUME_CACHE="devcontainer_cache"

# Host directory to always mount into the container (leave empty to skip)
PROJECTS_DIR="$HOME/projects"

# ------------------------------------------------------------------------------
# 5. Compiler & Runtime Environment
# ------------------------------------------------------------------------------
# Default compilers inside container
DEFAULT_CC="clang"
DEFAULT_CXX="clang++"

# Timezone inside container
DEV_TIMEZONE="Europe/Berlin"

# Path to llvm-symbolizer inside container
SYMBOLIZER_PATH="/usr/local/bin/llvm-symbolizer"

# AddressSanitizer (ASan) options
ASAN_OPTIONS="detect_container_overflow=0:detect_leaks=1:symbolize=1"

# ThreadSanitizer (TSan) options
TSAN_OPTIONS="external_symbolizer_path=${SYMBOLIZER_PATH}:symbolize=1:halt_on_error=1:second_deadlock_stack=1:ignore_noninstrumented_modules=1:die_after_fork=0"
